<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>formatVersion</key><integer>1</integer>
	<key>identifier</key><string>local.dynject.oledfinder</string>
	<key>name</key><string>OLED Finder</string>
	<key>summary</key><string>Pure black Finder browser windows. No settings: the colours are constants in OLEDFinder.m.</string>
	<key>version</key><string>0.1.0</string>
	<key>minimumSystemVersion</key><string>27.0</string>
	<key>testedSystemVersions</key><string>27.2</string>
	<key>author</key><string>Dynject Workbench example</string>
	<key>dylib</key><string>/opt/dynject/lib/tweaks/libOLEDFinder.dylib</string>
	<key>takesEffect</key><string>relaunch</string>
	<!-- What dw doctor --apis checks after a macOS update. Finder's window classes live in its executable, which can't
	     be loaded, so they are looked up as strings. Without NSGlassEffectView or NSScrollPocket the sidebar glass and
	     the scroll edge effect keep their stock colours; the rest still works. -->
	<key>requires</key>
	<array>
		<dict>
			<key>string</key><string>TBrowserWindow</string>
			<key>image</key><string>/System/Library/CoreServices/Finder.app/Contents/MacOS/Finder</string>
		</dict>
		<dict>
			<key>string</key><string>TDesktopWindow</string>
			<key>image</key><string>/System/Library/CoreServices/Finder.app/Contents/MacOS/Finder</string>
		</dict>
		<dict>
			<key>class</key><string>NSGlassEffectView</string>
			<key>image</key><string>AppKit</string>
			<key>methods</key><array><string>-setContentView:</string><string>-contentView</string><string>-cornerRadius</string></array>
			<key>optional</key><true/>
		</dict>
		<dict>
			<key>class</key><string>NSScrollPocket</string>
			<key>image</key><string>AppKit</string>
			<key>optional</key><true/>
		</dict>
	</array>
</dict>
</plist>
