<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>formatVersion</key><integer>1</integer>
	<key>identifier</key><string>local.dynject.menuloader</string>
	<key>name</key><string>MenuLoader</string>
	<key>summary</key><string>Adds the Apple-menu items that tweaks (and Dynject Workbench) declare to the Apple menu of every app it is injected into. Pure infrastructure: it has no items of its own.</string>
	<key>version</key><string>1.1</string>
	<key>author</key><string>Dynject Workbench</string>
	<key>dylib</key><string>/opt/dynject/lib/tweaks/libMenuLoader.dylib</string>
	<key>takesEffect</key><string>live</string>
	<key>sections</key>
	<array>
		<dict>
			<key>title</key><string>Apple Menu</string>
			<key>footer</key><string>Which items appear, and whether a tweak gets its own submenu or a section of the shared one, is decided by the tweaks' manifests, the Show in Apple menu switch on each tweak's page and Workbench's Apple-menu options (which also hide the Dynject menu).</string>
			<key>items</key>
			<array>
				<dict>
					<key>type</key><string>switch</string>
					<key>key</key><string>enabled</string>
					<key>title</key><string>Show tweak items in the Apple menu</string>
					<key>footer</key><string>Off removes everything MenuLoader adds, the Dynject menu included.</string>
					<key>default</key><true/>
					<key>perApp</key><true/>
				</dict>
				<dict>
					<key>type</key><string>choice</string>
					<key>key</key><string>placement</string>
					<key>title</key><string>Shared menu style</string>
					<key>options</key>
					<array>
						<dict><key>value</key><string>auto</string><key>title</key><string>Workbench default</string></dict>
						<dict><key>value</key><string>submenu</string><key>title</key><string>In a submenu</string></dict>
						<dict><key>value</key><string>section</string><key>title</key><string>Directly in the Apple menu</string></dict>
					</array>
					<key>default</key><string>auto</string>
					<key>footer</key><string>For tweaks that share one menu. Workbench default uses the style Workbench publishes (a submenu unless changed). Tweaks with their own submenu keep it.</string>
					<key>perApp</key><true/>
					<key>enabledIf</key><string>enabled</string>
				</dict>
				<dict>
					<key>type</key><string>text</string>
					<key>key</key><string>submenuTitle</string>
					<key>title</key><string>Shared submenu title</string>
					<key>default</key><string></string>
					<key>placeholder</key><string>Tweaks</string>
					<key>footer</key><string>Leave empty to use the title Workbench publishes.</string>
					<key>enabledIf</key><string>enabled</string>
				</dict>
			</array>
		</dict>
		<dict>
			<key>title</key><string>Troubleshooting</string>
			<key>items</key>
			<array>
				<dict>
					<key>type</key><string>switch</string>
					<key>key</key><string>diagnostics</string>
					<key>title</key><string>Log diagnostics</string>
					<key>default</key><false/>
					<key>footer</key><string>Logs the item list and the Apple menu after each change (subsystem local.dynject.menuloader).</string>
				</dict>
			</array>
		</dict>
	</array>
</dict>
</plist>
